
# Copy this file to .env and fill in your actual values
# DO NOT use defaults like "changeme" or "password"

# ═════════════════════════════════════════════════════════════════
# REQUIRED SECRETS (Must be set before deployment)
# ═════════════════════════════════════════════════════════════════

# Trakt API credentials (get from https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Emby API credentials
EMBY_URL=http://192.168.1.xxx:8096
EMBY_API_KEY=xxx

# ✅ SECURITY: Strong database password (minimum 12 characters)
# 
DB_PASSWORD=xxx

# ✅ SECURITY: Strong Redis password
# 
REDIS_PASSWORD=xxxx

# ✅ SECURITY: JWT secret key for authentication
# 
JWT_SECRET_KEY=xxxx

# ═════════════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION (Defaults provided)
# ═════════════════════════════════════════════════════════════════

# Database configuration
DB_USER=embytrakt
DB_NAME=embytrakt

# Feature toggles (default: all enabled)
ENABLE_SMART_QUEUE=true
ENABLE_ML_PREDICTOR=true
ENABLE_UNIVERSE_DISCOVERY=true
ENABLE_WATCH_PARTY=true
ENABLE_RATING_BIAS_DETECTOR=true


# ✅ SECURITY: CORS allowed origins
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server ports
SUITE_PORT=8000
WS_PORT=8001


